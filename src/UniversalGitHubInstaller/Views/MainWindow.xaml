<Window x:Class="UniversalGitHubInstaller.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:UniversalGitHubInstaller.ViewModels"
        Title="Mercury - Universal GitHub &amp; Terminal Installer"
        Width="1100" Height="780" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PrimaryBgBrush}"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Navigation -->
        <Border Grid.Column="0" Background="{StaticResource SecondaryBgBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- App Header -->
                <StackPanel DockPanel.Dock="Top" Margin="16,20,16,24">
                    <Border CornerRadius="10" Width="44" Height="44" HorizontalAlignment="Left" Margin="0,0,0,10"
                            Background="#111827" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Image Source="/assets/icon.png" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Text="Mercury" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="GitHub &amp; Terminal Installer" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="v1.0.0 • Windows &amp; Apple" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Version Info at Bottom -->
                <TextBlock DockPanel.Dock="Bottom" Text="© 2026 Mercury"
                           FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="16,0,0,12"/>

                <!-- Nav Items -->
                <StackPanel Margin="8,0">
                    <RadioButton x:Name="NavHome" Content="Home" Tag="🏠"
                                 Style="{StaticResource NavButton}" IsChecked="True"
                                 Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavProject" Content="Project" Tag="📦"
                                 Style="{StaticResource NavButton}"
                                 Checked="Nav_Checked"
                                 IsEnabled="{Binding HasProject}"/>
                    <RadioButton x:Name="NavEnvironment" Content="Environment" Tag="🖥️"
                                 Style="{StaticResource NavButton}"
                                 Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavSecurity" Content="Security" Tag="🔒"
                                 Style="{StaticResource NavButton}"
                                 Checked="Nav_Checked"
                                 IsEnabled="{Binding HasProject}"/>
                    <RadioButton x:Name="NavBuild" Content="Build &amp; Run" Tag="▶"
                                 Style="{StaticResource NavButton}"
                                 Checked="Nav_Checked"
                                 IsEnabled="{Binding HasProject}"/>
                    <RadioButton x:Name="NavLogs" Content="Activity Log" Tag="📋"
                                 Style="{StaticResource NavButton}"
                                 Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavDiagnostics" Content="Diagnostics" Tag="🔧"
                                 Style="{StaticResource NavButton}"
                                 Checked="Nav_Checked"/>
                    <Separator Margin="12,8" Background="{StaticResource BorderBrush}"/>
                    <RadioButton x:Name="NavSettings" Content="Settings" Tag="⚙"
                                 Style="{StaticResource NavButton}"
                                 Checked="Nav_Checked"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content Area -->
        <DockPanel Grid.Column="1">
            <!-- Status Bar -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource SecondaryBgBrush}"
                    Padding="16,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ProjectPath}"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                               MaxWidth="400" TextTrimming="CharacterEllipsis"/>
                    <ProgressBar DockPanel.Dock="Right" Width="120" Height="4" Margin="12,0"
                                 Value="{Binding Progress}" Maximum="100"
                                 Foreground="{StaticResource AccentBrush}"
                                 Background="{StaticResource CardBgBrush}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                </DockPanel>
            </Border>

            <!-- Page Content -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
                <Grid>
                    <!-- HOME PAGE -->
                    <StackPanel x:Name="PageHome" Visibility="Visible">
                        <TextBlock Text="Welcome to ☿ Mercury" FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                        <TextBlock Text="Install any GitHub repository or execute installation commands across Windows &amp; Apple terminals with full internet access."
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,20"/>

                        <!-- Universal Command & GitHub URL Input Card -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="⚡ Universal Install &amp; Command Processor" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <Border Background="#0284c7" CornerRadius="4" Padding="8,3" HorizontalAlignment="Right"
                                            Visibility="{Binding DetectedBadge, Converter={StaticResource StringNotEmptyToVis}}">
                                        <TextBlock Text="{Binding DetectedBadge}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                </DockPanel>

                                <DockPanel Margin="0,4,0,8">
                                    <Button DockPanel.Dock="Right" Content="⚡ Smart Install &amp; Run"
                                            Style="{StaticResource PrimaryButton}"
                                            Command="{Binding SmartInstallCommand}" Margin="10,0,0,0"/>
                                    <TextBox Text="{Binding GitUrl, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalContentAlignment="Center" FontSize="13" Padding="8,6"
                                             Background="{StaticResource SecondaryBgBrush}"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             BorderBrush="{StaticResource BorderBrush}"/>
                                </DockPanel>

                                <TextBlock Text="Paste ANY GitHub URL (https://github.com/user/project, user/project), git clone command, PowerShell one-liner (irm ... | iex), or Apple Terminal command (curl ... | bash)"
                                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Direct Terminal & Shell Access Card -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="💻 Direct Terminal &amp; Shell Access" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Full Internet &amp; Admin Access" FontSize="11"
                                               Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <TextBlock Text="Direct access to system terminals with execution policy bypass and TLS 1.2/1.3 enabled:"
                                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                                <WrapPanel>
                                    <Button Content="💻 Open PowerShell" Style="{StaticResource SecondaryButton}"
                                            Command="{Binding OpenPowerShellCommand}" Margin="0,0,10,6"
                                            ToolTip="Opens PowerShell with ExecutionPolicy Bypass &amp; TLS 1.2/1.3"/>
                                    <Button Content="🖥️ Open CMD" Style="{StaticResource SecondaryButton}"
                                            Command="{Binding OpenCmdCommand}" Margin="0,0,10,6"
                                            ToolTip="Opens Windows Command Prompt"/>
                                    <Button Content="🍏 Open Terminal / Unix Shell" Style="{StaticResource SecondaryButton}"
                                            Command="{Binding OpenAppleTerminalCommand}" Margin="0,0,10,6"
                                            ToolTip="Opens Apple Terminal (macOS) or Unix terminal"/>
                                    <Button Content="📁 Open Projects Folder" Style="{StaticResource SecondaryButton}"
                                            Command="{Binding OpenProjectFolderCommand}" Margin="0,0,10,6"
                                            ToolTip="Opens Mercury projects storage directory"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Drop Zone -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16" MinHeight="110"
                                Background="{StaticResource SecondaryBgBrush}"
                                BorderThickness="2"
                                AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="#475569"/>
                            </Border.BorderBrush>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="📁" FontSize="30" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock Text="Drop GitHub Project, Folder, ZIP, or Text Here"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Drag and drop any folder, ZIP archive, or copied command directly"
                                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Action Buttons -->
                        <WrapPanel Margin="0,0,0,16">
                            <Button Content="📁 Browse Folder" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding BrowseFolderCommand}" Margin="0,0,12,8"/>
                            <Button Content="📦 Open ZIP" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding OpenZipCommand}" Margin="0,0,12,8"/>
                        </WrapPanel>
                    </StackPanel>

                    <!-- PROJECT PAGE -->
                    <StackPanel x:Name="PageProject" Visibility="Collapsed">
                        <TextBlock Text="Project Analysis" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                        <!-- Project Info Card -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/><RowDefinition/>
                                    <RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Project Name" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ProjectInfo.Name}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="0,4"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Location" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ProjectInfo.Path}" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,4"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Git Remote" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ProjectInfo.GitRemote, TargetNullValue='-'}" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,4"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Branch" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ProjectInfo.Branch, TargetNullValue='-'}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Commit" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ProjectInfo.Commit, TargetNullValue='-'}" Foreground="{StaticResource AccentBrush}" Margin="0,4"/>
                            </Grid>
                        </Border>

                        <!-- Technologies -->
                        <TextBlock Text="Detected Technologies" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <ItemsControl ItemsSource="{Binding Technologies}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,4">
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Status}"
                                                       Foreground="{StaticResource SuccessBrush}" FontSize="14" Width="24"/>
                                            <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                                            <TextBlock Text="{Binding Version}" Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="12" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <!-- Services -->
                        <TextBlock Text="Detected Services" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"
                                   Visibility="{Binding HasProject, Converter={StaticResource BoolToVis}}"/>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16"
                                Visibility="{Binding HasProject, Converter={StaticResource BoolToVis}}">
                            <ItemsControl ItemsSource="{Binding Services}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,4">
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" Width="180"/>
                                            <TextBlock Text="{Binding Type}" Foreground="{StaticResource TextSecondaryBrush}" Width="120"/>
                                            <TextBlock Text="{Binding Port, StringFormat='Port: {0}'}" Foreground="{StaticResource AccentBrush}"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <!-- Environment Variables -->
                        <TextBlock Text="Environment Configuration" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <ItemsControl ItemsSource="{Binding EnvironmentVars}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,4">
                                            <TextBlock Text="{Binding Key}" Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontFamily="Consolas" Width="250"/>
                                            <TextBlock Text="{Binding Status}" FontSize="11" Width="80"
                                                       Foreground="{Binding Status, Converter={StaticResource StatusToColor}}"/>
                                            <TextBlock Text="{Binding Value}" Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <!-- Action buttons -->
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="ðŸ“‚ Open Project Folder" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding OpenProjectFolderCommand}" Margin="0,0,8,8"/>
                            <Button Content="ðŸ”„ Update Project" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding UpdateProjectCommand}" Margin="0,0,8,8"/>
                            <Button Content="ðŸ”§ Repair Project" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding RepairProjectCommand}" Margin="0,0,8,8"/>
                        </WrapPanel>
                    </StackPanel>

                    <!-- ENVIRONMENT PAGE -->
                    <StackPanel x:Name="PageEnvironment" Visibility="Collapsed">
                        <TextBlock Text="Windows Environment" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                        <Button Content="ðŸ”§ Run System Diagnostics" Style="{StaticResource PrimaryButton}"
                                Command="{Binding RunDoctorCommand}" Margin="0,0,0,16"
                                HorizontalAlignment="Left"/>
                        <Border Style="{StaticResource CardBorder}">
                            <TextBlock Text="Click 'Run System Diagnostics' to scan your Windows environment for installed runtimes, tools, and system status."
                                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>

                    <!-- SECURITY PAGE -->
                    <StackPanel x:Name="PageSecurity" Visibility="Collapsed">
                        <TextBlock Text="Security Scan" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                        <Border Style="{StaticResource CardBorder}">
                            <TextBlock Text="Security scan results will appear here after project analysis."
                                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>

                    <!-- BUILD & RUN PAGE -->
                    <StackPanel x:Name="PageBuild" Visibility="Collapsed">
                        <TextBlock Text="Build &amp; Run" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                        <WrapPanel Margin="0,0,0,20">
                            <Button Content="ðŸ“¥ Install Dependencies" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding InstallDependenciesCommand}" Margin="0,0,12,8"/>
                            <Button Content="ðŸ”¨ Build" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding BuildProjectCommand}" Margin="0,0,12,8"/>
                            <Button Content="ðŸ§ª Test" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding TestProjectCommand}" Margin="0,0,12,8"/>
                            <Button Content="â–¶ Run Project" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding RunProjectCommand}" Margin="0,0,12,8"
                                    Background="#10B981"/>
                            <Button Content="â¹ Stop" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding StopProjectCommand}" Margin="0,0,12,8"
                                    Background="#EF4444" Foreground="White"/>
                            <Button Content="âŒ Cancel" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding CancelCommand}" Margin="0,0,12,8"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                        </WrapPanel>

                        <!-- Build/Test/Run info -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <DockPanel Margin="0,4">
                                    <TextBlock Text="Build Command:" Foreground="{StaticResource TextSecondaryBrush}" Width="140"/>
                                    <TextBlock Text="{Binding ProjectInfo.BuildSystem, TargetNullValue='Not detected'}"
                                               Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Consolas"/>
                                </DockPanel>
                                <DockPanel Margin="0,4">
                                    <TextBlock Text="Test Command:" Foreground="{StaticResource TextSecondaryBrush}" Width="140"/>
                                    <TextBlock Text="{Binding ProjectInfo.TestSystem, TargetNullValue='Not detected'}"
                                               Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Consolas"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- LOGS PAGE -->
                    <StackPanel x:Name="PageLogs" Visibility="Collapsed">
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="Activity Log" FontSize="24" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" DockPanel.Dock="Left"/>
                            <Button Content="📁 Open Log Files" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding OpenLogsFolderCommand}" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <Border Style="{StaticResource CardBorder}" MaxHeight="500">
                            <ListBox ItemsSource="{Binding LogEntries}"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     FontFamily="Consolas" FontSize="12"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                        </Border>
                    </StackPanel>

                    <!-- DIAGNOSTICS PAGE -->
                    <StackPanel x:Name="PageDiagnostics" Visibility="Collapsed">
                        <TextBlock Text="System Diagnostics" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                        <Button Content="🩺 Run Doctor" Style="{StaticResource PrimaryButton}"
                                Command="{Binding RunDoctorCommand}" Margin="0,0,0,16"
                                HorizontalAlignment="Left"/>
                        <Border Style="{StaticResource CardBorder}">
                            <TextBlock Text="Run the Doctor command to diagnose your Windows environment, check installed runtimes, package managers, Docker, PATH, permissions, network, and disk space."
                                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>

                    <!-- SETTINGS PAGE -->
                    <StackPanel x:Name="PageSettings" Visibility="Collapsed">
                        <TextBlock Text="Settings" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Application settings will be available in a future update."
                                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="Version 1.0.0" Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
