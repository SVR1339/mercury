<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>UniversalGitHubInstaller</RootNamespace>
    <AssemblyName>UniversalGitHubInstaller</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>Mercury</Product>
    <Company>Mercury</Company>
    <Description>Mercury - Universal GitHub &amp; Terminal Installer for Windows and Apple</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <Resource Include="assets\icon.png" />
    <Resource Include="assets\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UniversalGitHubInstaller.Core\UniversalGitHubInstaller.Core.csproj" />
  </ItemGroup>

</Project>
